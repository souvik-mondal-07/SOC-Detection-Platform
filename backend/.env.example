# Copy this file to ".env" and adjust values. Never commit ".env".
APP_NAME=SOC Detection Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (the only database used by this project)
# For a local MongoDB without authentication, use the default below.
# If your MongoDB requires credentials, put them ONLY in your private .env file.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=soc_detection_platform
# How long (milliseconds) to wait for MongoDB before reporting it as unavailable
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
